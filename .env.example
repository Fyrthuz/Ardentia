# WildfireRisk-ES — variables de entorno (copia a .env y rellena)
# AEMET OpenData (alta en opendata.aemet.es/centrodedescargas/altaUsuario; caduca 90 días)
AEMET_API_KEY=

# Copernicus CDS/ADS (claves en https://ads.atmosphere.copernicus.eu/profile -> API keys)
# Alternativa: ~/.cdsapirc ya configurado
CDS_API_KEY=

# Google Earth Engine (service account JSON o user auth via `earthengine authenticate`)
GEE_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Opcionales
GCS_BUCKET=
